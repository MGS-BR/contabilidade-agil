{
  "name": "contabilidade-agil",
  "version": "1.0.0",
  "private": true,
  "description": "Contabilidade Ágil — sistema de gestão contábil com sugestão de lançamentos por IA (TG Fatec Sorocaba)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"node --watch server/index.js\" \"vite --config client/vite.config.js\"",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "db:setup": "node server/setup-db.js",
    "db:reset": "node server/setup-db.js --reset",
    "test": "node --test tests/api.test.js",
    "test:e2e": "node tests/e2e.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "playwright-core": "^1.65.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.72.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
