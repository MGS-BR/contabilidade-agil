# Copie para .env (ou exporte no terminal) para rodar localmente.

# PostgreSQL. Local: postgres://postgres:SENHA@localhost:5432/contabilidade_agil
# Neon: use a string SEM "-pooler" (Connection pooling desligado no botão Connect)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/contabilidade_agil

# Chave para assinar os tokens de login. Em produção, use um valor longo e aleatório.
JWT_SECRET=troque-esta-chave

# Porta da API (o Render define sozinho)
PORT=3000

# true: na primeira subida, se o schema "contabil" não existir, cria tudo
DB_AUTO_SETUP=true

# Pasta dos arquivos enviados (no Render gratuito o disco é apagado a cada deploy)
UPLOAD_DIR=uploads
